#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_MOUSE_DEFAULT_SCRL_VAL 100
#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        comb1 {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        comb2 {
            bindings = <&kp LS(ESCAPE)>;
            key-positions = <0 1>;
        };

        comb3 {
            bindings = <&kp CAPSLOCK>;
            key-positions = <22 23>;
        };

        comb4 {
            bindings = <&kp BACKSPACE>;
            key-positions = <9 8>;
        };

        comb5 {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <9 8>;
            timeout-ms = <0>;
            layers = <4>;
        };

        MS_BTN1_ {
            bindings = <&mkp MB1>;
            key-positions = <38 39>;
        };

        MS_BTN2_ {
            bindings = <&mkp MB2>;
            key-positions = <38 37>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    // エンコーダー：キー

    rot_kp: sensor_rotate_kp {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        bindings = <&kp>, <&kp>;
    };

    // エンコーダー：マウススクロール 

    rot_msc: sensor_rotate_msc {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        tap-ms = <20>;
        bindings = <&msc>, <&msc>;
    };

    // エンコーダー：マウススクロール(MOVE_Y)

    scroll_move_y: sensor_rotate_msc_for_move_y {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;

        // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>

        tap-ms = <65>;
    };

    // エンコーダー：マウススクロール(MOVE_X)

    scroll_move_x: sensor_rotate_msc_for_move_x {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;

        // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>

        tap-ms = <65>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                    &kp W                                 &kp E         &kp R         &kp T                                                     &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A                    &kp S                                 &kp D         &kp F         &kp G        &tog 1                &kp PRINTSCREEN        &kp H        &kp J  &kp K      &kp L       &mt RIGHT_GUI RETURN
&mt LEFT_SHIFT Z         &kp X                                 &kp C         &kp V         &kp B        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N        &kp M  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT SLASH
&mt LEFT_CONTROL ESCAPE  &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &kp LEFT_ALT  &kp LEFT_GUI  &lt 4 LANG2  &lt 5 SPACE           &mt RIGHT_SHIFT ENTER  &lt 3 LANG1                                &mt RIGHT_CONTROL DELETE
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        Win {
            bindings = <
&kp Q                    &kp W               &kp E         &kp R         &kp T                                                               &kp Y                  &kp U  &kp I      &kp O       &kp P
&kp A                    &kp S               &kp D         &kp F         &kp G                  &tog 0                &kp PRINTSCREEN        &kp H                  &kp J  &kp K      &kp L       &mt RIGHT_GUI ENTER
&kp Z                    &kp X               &kp C         &kp V         &kp B                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N                  &kp M  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT SLASH
&mt LEFT_CONTROL ESCAPE  &kp K_CONTEXT_MENU  &kp LEFT_ALT  &kp LEFT_GUI  &lt 4 INTERNATIONAL_5  &lt 5 SPACE           &mt RIGHT_SHIFT ENTER  &lt 3 INTERNATIONAL_4                                &mt RIGHT_CONTROL DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        AML {
            bindings = <
&kp Q       &kp W    &kp E             &kp R         &kp T                                                      &kp Y          &kp U     &kp I  &kp O     &kp P
&kp A       &kp S    &kp D             &kp F         &kp G         &to 3                 &kp MINUS              &kp H          &mkp MB1  &kp K  &mkp MB2  &kp ENTER
&kp Z       &kp X    &kp C             &kp V         &kp B         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N          &kp M     &mo 6  &mkp MB5  &kp SLASH
&kp ESCAPE  &kp TAB  &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &lt 3 SPACE           &lt 4 SPACE            &kp BACKSPACE                             &kp LEFT_SHIFT
            >;

            sensor-bindings = <&scroll_move_y>;
        };

        SYMBOL {
            bindings = <
&kp LS(N1)            &kp LS(N2)   &kp LS(N3)  &kp LS(N4)       &kp LS(N5)                                              &kp LS(N6)  &kp LS(N7)      &kp LS(N8)            &kp LS(N9)        &kp LS(N0)
&mt LEFT_CONTROL TAB  &kp AT_SIGN  &kp HOME    &kp GRAVE        &kp SQT            &kp K_MUTE        &kp PRINTSCREEN    &kp EQUAL   &kp MINUS       &kp NON_US_BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp PLUS              &kp MINUS    &kp END     &kp LS(SLASH)    &kp DOUBLE_QUOTES  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PLUS    &kp UNDERSCORE  &kp PIPE              &kp LEFT_BRACE    &kp RIGHT_BRACE
&none                 &kp K_EJECT  &none       &kp PRINTSCREEN  &kp DEL            &kp BACKSPACE     &mo 4              &none                                                               &kp LEFT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        ARROW {
            bindings = <
&kp F1                &kp F2   &kp F3            &kp F4     &kp F5                                                      &kp F6             &kp F7          &kp F8         &kp F9             &kp F10
&mt LEFT_CONTROL TAB  &kp F2   &kp F3            &kp F4     &kp F5            &mo 3           &kp INT_KATAKANAHIRAGANA  &kp LEFT           &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT          &kp PAGE_UP
&mt LEFT_SHIFT F6     &kp F7   &kp F8            &kp F9     &mt LEFT_ALT F10  &kp LEFT_BRACE  &kp RIGHT_BRACE           &kp LC(PAGE_UP)    &kp LS(LEFT)    &kp LS(RIGHT)  &kp LC(PAGE_DOWN)  &kp PAGE_DOWN
&kp F11               &kp F12  &kp LEFT_CONTROL  &kp ENTER  &none             &kp UNDERSCORE  &kp LG(LS(LEFT))          &kp LG(LS(RIGHT))                                                    &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_DOWN K_VOLUME_UP>;
        };

        NUM {
            bindings = <
&kp Q       &kp W    &kp E             &kp R         &kp T                          &kp Y            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp P
&kp A       &kp S    &kp D             &kp F         &kp G     &kp N1  &kp N2       &kp KP_NUMLOCK   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ENTER
&kp Z       &kp X    &kp C             &kp V         &kp B     &kp N3  &kp N4       &kp TAB          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp SLASH
&kp ESCAPE  &kp TAB  &kp LEFT_CONTROL  &kp LEFT_GUI  &mkp MB1  &none   &lt 4 SPACE  &kp KP_NUMBER_0                                                     &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &kp Y        &kp U     &kp I      &kp O     &kp P
&bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &kp N1  &none   &kp H        &mkp MB1  &mkp MB3   &mkp MB2  &kp ENTER
&bt BT_CLR      &none          &none          &kp V          &kp B          &kp N3  &none   &kp N        &mkp MB4  &kp COMMA  &mkp MB5  &gresc
&bt BT_CLR_ALL  &none          &none          &kp LALT       &lt 3 SPACE    &kp N5  &kp N6  &lt 4 SPACE                                 &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };
};
